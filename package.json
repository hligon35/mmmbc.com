{
  "name": "mmmbc",
  "private": true,
  "type": "module",
  "scripts": {
    "build:cf": "node ./scripts/build_cf_site.mjs",
    "test": "node --test src/*.test.mjs",
    "test:admin": "npm --prefix admin test",
    "test:all": "npm test && npm run test:admin",
    "check": "npm run build:cf && npm run migrate:local && npm run test:all && npm run verify:integrations && npm run worker:dry-run",
    "worker:dry-run": "wrangler deploy --dry-run",
    "migrate:local": "wrangler d1 migrations apply mmdb --local",
    "maintenance": "node ./scripts/monthly-maintenance.mjs",
    "seed:demo": "node ./scripts/seed_demo_data.mjs",
    "import:admins": "node ./scripts/import_admin_roster.mjs",
    "verify:integrations": "node ./scripts/verify_local_integrations.mjs",
    "verify:integrations:target": "node ./scripts/verify_integrations.mjs",
    "deploy": "npm run build:cf && npm run verify:admin-delivery && npx wrangler deploy",
    "build": "npm run build:cf",
    "prepare": "npm run build:cf",
    "verify:admin-delivery": "node scripts/verify_admin_delivery.mjs",
    "test:admin:browser": "npm run build:cf && npm run verify:admin-delivery && node scripts/test_admin_browser.mjs",
    "test:workspace:browser": "npm run test:admin:browser"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "wrangler": "^4.131.1"
  }
}
