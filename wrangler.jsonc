{
	"name": "mmmbc",
	"compatibility_date": "2026-01-21",
	// Worker entrypoint with branded Google authentication and admin API fallbacks.
	"main": "./src/worker-admin-api-wrapper.js",
	// Assets-only Worker deployment (static site)
	// This intentionally deploys ONLY the curated public-site files in ./cf_site
	// so that the admin server code and admin data are never published.
	"assets": {
		"directory": "./cf_site"
	},
	// Bindings (create these in Cloudflare, then fill in ids/names)
	"r2_buckets": [
		{
			"binding": "GALLERY_BUCKET",
			"bucket_name": "mmmbc-gallery"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mmdb",
			"database_id": "a981265d-7e16-486c-9d02-48dfa5017bed"
		}
	],
	"send_email": [
		{
			"name": "SUPPORT_EMAIL",
			"destination_address": "hligon@getsparqd.com"
		}
	],
	// Runs every 5 minutes; processes any newsletter_records rows that are due
	// (status = 'scheduled'/'retrying' and schedule_at <= now).
	// IMPORTANT: also declared under env.production below. `triggers` is inheritable,
	// but since this top-level block and env.production both deploy to the SAME
	// Worker name ("mmmbc"), a bare `npx wrangler deploy` (no --env) would silently
	// clear the cron trigger on the live Worker if this were missing here. Keep both in sync.
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	// Cloudflare-side Worker vars.
	// GOOGLE_CLIENT_ID, GOOGLE_ALLOWED_EMAILS, and SESSION_SECRET must be configured
	// as Cloudflare Worker secrets/variables before Google sign-in will be enabled.
	// DEVELOPER_EMAILS is a separate allowlist for storage/integration diagnostics;
	// it is checked server-side against the authenticated email and should stay
	// narrower than ADMIN_ALLOW_EMAILS when you want regular admins blocked.
	"vars": {
		"ADMIN_ALLOW_EMAILS": "hligon@getsparqd.com,hligon35@gmail.com,alphazonelabs@gmail.com",
		"DEVELOPER_EMAILS": "hligon@getsparqd.com,hligon35@gmail.com,alphazonelabs@gmail.com",
		"CANONICAL_HOST": "mmmbc.alphazonelabs.com",
		"ALLOW_SERVICE_TOKEN_ADMIN": "false",
		"DEV_BYPASS_AUTH": "false",
		"SUPPORT_TO_EMAIL": "support@hldesignedit.com",
		"SUPPORT_EMAIL_DESTINATION": "hligon@getsparqd.com",
		"SUPPORT_FROM_EMAIL": "needhelp@mmmbc.com",
		"SUPPORT_FROM_NAME": "Mount Moriah Admin",
		"PUBLIC_SITE_URL": "https://mmmbc.alphazonelabs.com"
	},
	// Always deploy with `npm run deploy` (== build:cf + wrangler deploy --env production).
	// env.production sets "name": "mmmbc", the SAME Worker name as this top-level block,
	// so a bare `npx wrangler deploy` (no --env) publishes to the identical live Worker —
	// it is NOT a separate/safe target. It also skips the build:cf step, risking stale
	// cf_site/ static assets. Only use it for a quick `--dry-run` config check.
	// Deploy preview instead: npx wrangler deploy --env preview
	"env": {
		"production": {
			// Deploy with: npm run deploy  (or npx wrangler deploy --env production)
			// Intended for the live custom domain.
			"name": "mmmbc",
			"main": "./src/worker-admin-api-wrapper.js",
			"assets": {
				"directory": "./cf_site"
			},
			"r2_buckets": [
				{
					"binding": "GALLERY_BUCKET",
					"bucket_name": "mmmbc-gallery"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "mmdb",
					"database_id": "a981265d-7e16-486c-9d02-48dfa5017bed"
				}
			],
			"send_email": [
				{
					"name": "SUPPORT_EMAIL",
					"destination_address": "hligon@getsparqd.com"
				}
			],
			// Runs every 5 minutes; processes any newsletter_records rows that are due
			// (status = 'scheduled'/'retrying' and schedule_at <= now).
			"triggers": {
				"crons": ["*/5 * * * *"]
			},
			"vars": {
				"ADMIN_ALLOW_EMAILS": "hligon@getsparqd.com,hligon35@gmail.com,alphazonelabs@gmail.com",
				"DEVELOPER_EMAILS": "hligon@getsparqd.com,hligon35@gmail.com,alphazonelabs@gmail.com",
				"CANONICAL_HOST": "mmmbc.alphazonelabs.com",
				"ALLOW_SERVICE_TOKEN_ADMIN": "false",
				"DEV_BYPASS_AUTH": "false",
				"SUPPORT_TO_EMAIL": "support@hldesignedit.com",
				"SUPPORT_EMAIL_DESTINATION": "hligon@getsparqd.com",
				"SUPPORT_FROM_EMAIL": "needhelp@mmmbc.com",
				"SUPPORT_FROM_NAME": "Mount Moriah Admin",
				"PUBLIC_SITE_URL": "https://mmmbc.alphazonelabs.com"
			}
		},
		"preview": {
			"name": "mmmbc-preview",
			"main": "./src/worker-admin-api-wrapper.js",
			"assets": {
				"directory": "./cf_site"
			},
			"r2_buckets": [
				{
					"binding": "GALLERY_BUCKET",
					"bucket_name": "mmmbc-gallery-preview"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "mmdb",
					"database_id": "a981265d-7e16-486c-9d02-48dfa5017bed"
				}
			],
			"send_email": [
				{
					"name": "SUPPORT_EMAIL",
					"destination_address": "hligon@getsparqd.com"
				}
			],
			"vars": {
				"ADMIN_ALLOW_EMAILS": "hligon@getsparqd.com,hligon35@gmail.com,alphazonelabs@gmail.com",
				"DEVELOPER_EMAILS": "hligon@getsparqd.com,hligon35@gmail.com,alphazonelabs@gmail.com",
				"CANONICAL_HOST": "mmmbc-preview.alphazonelabs.com",
				"ALLOW_SERVICE_TOKEN_ADMIN": "true",
				"DEV_BYPASS_AUTH": "false",
				"SUPPORT_TO_EMAIL": "support@hldesignedit.com",
				"SUPPORT_EMAIL_DESTINATION": "hligon@getsparqd.com",
				"SUPPORT_FROM_EMAIL": "needhelp@mmmbc.com",
				"SUPPORT_FROM_NAME": "Mount Moriah Admin",
				"PUBLIC_SITE_URL": "https://mmmbc-preview.alphazonelabs.com"
			}
		},
		"migrate": {
			"name": "mmmbc-migrate",
			"main": "./src/worker.js",
			"assets": {
				"directory": "./cf_site"
			},
			"r2_buckets": [
				{
					"binding": "GALLERY_BUCKET",
					"bucket_name": "mmmbc-gallery"
				},
				{
					"binding": "GALLERY_BUCKET_SRC",
					"bucket_name": "mmmbc-gallery-preview"
				},
				{
					"binding": "GALLERY_BUCKET_DST",
					"bucket_name": "mmmbc-gallery"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "mmdb",
					"database_id": "a981265d-7e16-486c-9d02-48dfa5017bed"
				}
			],
			"send_email": [
				{
					"name": "SUPPORT_EMAIL",
					"destination_address": "hligon@getsparqd.com"
				}
			],
			"vars": {
				"ADMIN_ALLOW_EMAILS": "hligon@getsparqd.com,hligon35@gmail.com,alphazonelabs@gmail.com",
				"DEVELOPER_EMAILS": "hligon@getsparqd.com,hligon35@gmail.com,alphazonelabs@gmail.com",
				"CANONICAL_HOST": "mmmbc.alphazonelabs.com",
				"ALLOW_SERVICE_TOKEN_ADMIN": "true",
				"DEV_BYPASS_AUTH": "false",
				"SUPPORT_TO_EMAIL": "support@hldesignedit.com",
				"SUPPORT_EMAIL_DESTINATION": "hligon@getsparqd.com"
			},
			"observability": {
				"enabled": false,
				"head_sampling_rate": 1,
				"logs": {
					"enabled": true,
					"head_sampling_rate": 1,
					"persist": true,
					"invocation_logs": true
				},
				"traces": {
					"enabled": true,
					"persist": true,
					"head_sampling_rate": 1
				}
			}
		}
	}
}
