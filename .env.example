# Application
ENVIRONMENT=development
SITE_URL=https://mmmbc.alphazonelabs.com
PUBLIC_API_URL=https://mmmbc.alphazonelabs.com
PUBLIC_ADMIN_URL=https://mmmbc.alphazonelabs.com/admin/
CANONICAL_HOST=mmmbc.alphazonelabs.com
CORS_ORIGINS=https://mmmbc.alphazonelabs.com
ADMIN_ALLOW_EMAILS=
DEVELOPER_EMAILS=
ADMIN_NOTIFICATION_EMAIL=
NEWSLETTER_UNSUBSCRIBE_SECRET=
NEWSLETTER_TIMEZONE=America/Chicago
GIVING_PROVIDER=zeffy
ZEFFY_DONATION_URL=https://www.zeffy.com/en-US/donation-form/tithes-and-offering-59
# Optional override: use the iframe src or data-form-url from Zeffy's Campaign embed.
# If omitted, the page derives /embed/donation-form/<campaign-slug> from the share URL.
# Supply a full https://www.zeffy.com URL; an empty value disables the embed.
# ZEFFY_EMBED_URL=https://www.zeffy.com/embed/donation-form/<campaign-slug>

# Admin donation sync: API key is a Worker secret (or gitignored .dev.vars locally).
ZEFFY_API_KEY=
# API campaign IDs, NOT the donation page slug. Comma-separated donation campaigns.
ZEFFY_CAMPAIGN_IDS=
# Optional emergency stop. Sync activates when the key and campaign IDs are present.
ZEFFY_SYNC_ENABLED=true
# Set only after checking one API payment against the Zeffy dashboard.
# minor = integer cents; major = dollars. Blank shows labeled API values.
ZEFFY_AMOUNT_UNIT=
# Optional JSON field-path overrides after confirming the account's payment schema.
# Defaults: amount,currency,created,status,buyer.name,buyer.email,refunds.
ZEFFY_PAYMENT_MAPPING={}

# Cloudflare CLI/provisioning
CLOUDFLARE_ACCOUNT_ID=e02ea8e0b7fe319f04e2505df1138d4c
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=a981265d-7e16-486c-9d02-48dfa5017bed
R2_BUCKET=mmmbc
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@mmmbc.com
RESEND_FROM_NAME=Mount Moriah Missionary Baptist Church
RESEND_REPLY_TO_EMAIL=
RESEND_TEST_RECIPIENTS=
MAINTENANCE_TO_EMAIL=

# Existing payment and media integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
